# =============================================================
# !! USE A SECONDARY ACCOUNT — NEVER YOUR PERSONAL ACCOUNT !!
# Instagram may restrict or ban accounts used for scraping.
# Create a dedicated account just for this purpose.
# =============================================================

# Instagram credentials (for login.py to authenticate)
INSTAGRAM_USERNAME=your_secondary_account
INSTAGRAM_PASSWORD=your_password

# Session cookies (auto-filled by login.py — DO NOT edit manually)
# This is a base64-encoded JSON string with your session cookies.
# login.py writes this automatically after successful login.
INSTAGRAM_COOKIES=

# Database
DATABASE_URL=sqlite:///./data/scraper.db

# Safety limits
MAX_PROFILES_PER_RUN=15
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=60
MAX_SESSION_MINUTES=20
DELAY_BETWEEN_POSTS=8
MAX_DAYS=5
MAX_POSTS_PER_PROFILE=6
SAFE_HOUR_START=7
SAFE_HOUR_END=23
